#!/bin/sh
# Windows: Rtools ships OpenSSL, so the slice uses it there too. Schannel
# (D-5) replaces this at S8.
set -eu
if command -v pkg-config >/dev/null 2>&1 && pkg-config --exists openssl 2>/dev/null; then
    SSL_CFLAGS=$(pkg-config --cflags openssl)
    SSL_LIBS=$(pkg-config --libs openssl)
else
    SSL_CFLAGS=""
    SSL_LIBS="-lssl -lcrypto -lcrypt32 -lbcrypt"
fi
sed -e "s|@SSL_CFLAGS@|$SSL_CFLAGS|g" -e "s|@SSL_LIBS@|$SSL_LIBS|g" \
    src/Makevars.win.in > src/Makevars.win
echo "configure.win: wrote src/Makevars.win"
