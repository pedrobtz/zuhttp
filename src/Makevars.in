# GENERATED FROM src/Makevars.in BY ./configure -- DO NOT EDIT src/Makevars
# Vendored code lives in an isolated directory (design §48), and R does not
# compile src/ subdirectories automatically, so OBJECTS is listed explicitly.
# Every new source file must be added here -- AND in src/Makevars.win.in, which
# is the same list for Windows. See the note there: the two drifted, and
# tools/check-objects-sync now compares them.

# URI_NO_UNICODE / URI_STATIC_BUILD are required by the vendored uriparser
# subset; see src/vendor/uriparser/VENDOR. src/zuh_uriparser.h sets them too,
# so our own translation units stay correct even if this line is edited.
# nghttp2 (design §48, §65): NGHTTP2_STATICLIB empties NGHTTP2_EXTERN so
# $(C_VISIBILITY) hides its symbols (D-66); NDEBUG compiles its assert()s out;
# HAVE_CONFIG_H stays undefined and the HAVE_* macros below replace config.h.
# src/vendor/nghttp2/VENDOR lists the six patches these complete.
PKG_CPPFLAGS = -I. -Ivendor/picohttpparser -Ivendor/uriparser -Ivendor/nghttp2 \
               -DURI_NO_UNICODE -DURI_STATIC_BUILD @SSL_CFLAGS@ \
               -DNDEBUG -DNGHTTP2_STATICLIB -DBUILDING_NGHTTP2 \
               -DHAVE_ARPA_INET_H -DHAVE_NETINET_IN_H \
               -DHAVE_CLOCK_GETTIME -DHAVE_DECL_CLOCK_MONOTONIC=1

# Hidden by default, vendored code included: the shared object exports only
# R_init_zuhttp, which init.c marks attribute_visible (D-66). R reaches every
# other routine through registration, never by symbol lookup.
PKG_CFLAGS = $(C_VISIBILITY)

# @-substituted by ./configure, which locates OpenSSL. System zlib is
# decision D-7 and is present everywhere R runs.
PKG_LIBS = @SSL_LIBS@ -lz

OBJECTS = init.o \
          zuh_alloc.o \
          zuh_buffer.o \
          zuh_error.o \
          zuh_time.o \
          zuh_stream.o \
          zuh_headers.o \
          zuh_request.o \
          zuh_framing.o \
          zuh_response.o \
          zuh_uri.o \
          zuh_redirect.o \
          zuh_inflate.o \
          zuh_net.o \
          zuh_tls.o \
          @TLS_OBJ@ \
          zuh_engine.o \
          zuh_fork.o \
          zuh_pool.o \
          zuh_sink.o \
          zuh_body.o \
          zuh_trace.o \
          zuh_proxy.o \
          zuh_redact.o \
          zuh_h2.o \
