# Vendored code lives in an isolated directory (design §48), and R does not
# compile src/ subdirectories automatically, so OBJECTS is listed explicitly.
# Every new source file must be added here.

PKG_CPPFLAGS = -I. -Ivendor/picohttpparser

# System zlib (decision D-7). Present on every platform R targets; Rtools
# ships it. Declared in DESCRIPTION SystemRequirements.
PKG_LIBS = -lz

OBJECTS = init.o \
          zu_alloc.o \
          zu_buffer.o \
          zu_error.o \
          zu_time.o \
          zu_stream.o \
          zu_mock_stream.o \
          zu_headers.o \
          zu_request.o \
          zu_framing.o \
          zu_response.o \
          zu_uri.o \
          zu_redirect.o \
          zu_inflate.o \
          vendor/picohttpparser/picohttpparser.o
