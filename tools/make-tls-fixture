#!/bin/sh
# Regenerates tests/testthat/fixtures/tls/, the §50.5 certificate matrix:
# two CAs and eight leaves, committed with this script as their provenance
# (review #193; the matrix used to be generated at test time, and skipped
# itself whenever the openssl CLI changed). Run from the package root:
#
#   tools/make-tls-fixture
#
# Nothing here touches a trust store. The keys are test material and
# protect nothing. Validity: the CAs for ten years; the three "live" leaves
# for 397 days from the day this runs, because Apple's SecTrust refuses a
# TLS server certificate valid for more than 398 days, whoever signed it,
# and the macOS leg would otherwise fail every row with "certificate is not
# standards compliant". test-certs.R fails, naming this script, when the
# live leaves are within 45 days of expiry: re-run it then and commit.
# `expired` and `notyet` carry fixed dates, which is what makes them static.
set -eu
out=tests/testthat/fixtures/tls
rm -rf "$out"
mkdir -p "$out"
cd "$out"

ca() {   # name cn
  openssl req -x509 -newkey rsa:2048 -keyout "$1.key" -out "$1.pem" \
    -days 3650 -nodes -subj "/CN=$2" 2>/dev/null
}
# Two CAs. The second signs a certificate the client is never told about,
# the "unknown or untrusted issuer" row of §14.6.
ca ca zuhttp-test-CA
ca rogueca zuhttp-rogue-CA

# A SAN is a DNS name unless it is given with its type, as IP:127.0.0.1 or
# DNS:127.0.0.1 are for the #246 rows; the CN is the name without the type.
ext() {  # name san
  case $2 in *:*) san=$2 ;; *) san=DNS:$2 ;; esac
  printf 'subjectAltName=%s\nbasicConstraints=CA:FALSE\nkeyUsage=digitalSignature,keyEncipherment\nextendedKeyUsage=serverAuth\n' "$san" > "$1.ext"
}
csr() {  # name san
  ext "$1" "$2"
  openssl req -newkey rsa:2048 -keyout "$1.key" -out "$1.csr" -nodes \
    -subj "/CN=${2#*:}" 2>/dev/null
}
leaf() { # name san signer
  csr "$1" "$2"
  openssl x509 -req -in "$1.csr" -CA "$3.pem" -CAkey "$3.key" -CAcreateserial \
    -out "$1.pem" -extfile "$1.ext" -days 397 2>/dev/null
}
# A leaf with explicit validity dates. `openssl ca -startdate` is the
# portable route; `x509 -not_before` is OpenSSL 3.4+.
dated() { # name from to
  csr "$1" localhost
  db="ca-db-$1"
  mkdir -p "$db"
  : > "$db/index.txt"
  echo 01 > "$db/serial"
  cat > "$db/ca.cnf" <<CNF
[ca]
default_ca=zu
[zu]
database=$db/index.txt
new_certs_dir=$db
serial=$db/serial
default_md=sha256
policy=pol
unique_subject=no
[pol]
commonName=supplied
CNF
  openssl ca -batch -notext -config "$db/ca.cnf" -cert ca.pem -keyfile ca.key \
    -in "$1.csr" -out "$1.pem" -extfile "$1.ext" \
    -startdate "$2" -enddate "$3" 2>/dev/null
  rm -rf "$db"
}

leaf good localhost ca
leaf wronghost other.test ca
leaf untrusted localhost rogueca
# #246: an IP literal matches iPAddress SANs only. `ip` is the control that
# 127.0.0.1 verifies at all; the other two must be refused as a name
# mismatch, one naming another address, one naming 127.0.0.1 as a DNS name.
leaf ip IP:127.0.0.1 ca
leaf ipother IP:127.0.0.2 ca
leaf ipdns DNS:127.0.0.1 ca
dated expired 20240101000000Z 20240201000000Z
dated notyet  20400101000000Z 20400201000000Z

rm -f ./*.csr ./*.ext ./*.srl
printf 'made on %s by tools/make-tls-fixture with %s\n' \
  "$(date -u +%Y-%m-%d)" "$(openssl version)" > PROVENANCE
ls
